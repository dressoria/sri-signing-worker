{
  "name": "sri-signing-worker",
  "version": "0.1.0",
  "description": "Appsolux SRI signing job worker — processes queued SriSigningJob records",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "scan": "ts-node src/index.ts scan",
    "run:once": "ts-node src/index.ts run:once",
    "scan:submission": "ts-node src/index.ts scan:submission",
    "submit:once": "ts-node src/index.ts submit:once",
    "recover:authorization": "ts-node src/index.ts recover:authorization",
    "check-env": "ts-node src/index.ts check-env",
    "test:xades-skeleton": "ts-node src/test-xades-skeleton.ts",
    "test:sri-soap-envelope": "ts-node src/test-sri-soap-envelope.ts",
    "test:sri-submission": "ts-node src/test-sri-submission.ts",
    "test:sri-soap-parser": "ts-node src/test-sri-soap-parser.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-forge": "^1.4.0",
    "pg": "^8.12.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
