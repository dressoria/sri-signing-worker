# PostgreSQL connection to Appsolux Core DB
# Use the same DB as the dashboard but with direct pg driver (no Prisma)
# Do NOT append ?schema=public — pg driver ignores it
DATABASE_URL_WORKER=postgresql://user:password@localhost:5432/appsolux_core

# Unique identifier for this worker instance (used for job locking)
WORKER_ID=sri-signing-worker-local

# Set to true if the DB uses SSL (production)
DB_SSL=false

# ---------------------------------------------------------------------------
# Firma real XAdES-BES
# ---------------------------------------------------------------------------

# Master switch for real XAdES-BES signing.
# When true: requires SRI_CERT_ENCRYPTION_KEY + SRI_CERT_STORAGE_PATH.
# Default: false (safe)
ENABLE_REAL_SRI_SIGNING=false

# Enables dry-run mode: worker processes jobs up to the signing point,
# generates the XML, but does NOT sign cryptographically.
# Useful to validate the job queue architecture without real certificates.
ENABLE_SRI_SIGNING_DRY_RUN=true

# If true AND dry-run enabled, marks jobs as SUCCEEDED with dry-run metadata.
# SriDocument.status is NOT changed to SIGNED in dry-run mode.
# Safe default is false — only enable for explicit testing of the success path.
DRY_RUN_MARK_SUCCESS=false

# ---------------------------------------------------------------------------
# Certificados cifrados
# ---------------------------------------------------------------------------

# AES-256-GCM encryption key for reading tenant certificates.
# Must be a 64-character hex string (32 bytes).
# Must match the key used by the dashboard when the certificate was uploaded.
# NEVER commit a real key — load from secrets manager or environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SRI_CERT_ENCRYPTION_KEY=

# Filesystem root where encrypted certificate files are stored.
# Structure: <SRI_CERT_STORAGE_PATH>/<encryptedCertificateStorageKey>
# Each encrypted file contains the AES-256-GCM ciphertext (v1:iv:tag:ciphertext format).
# Must be outside the web-accessible directory.
SRI_CERT_STORAGE_PATH=

# Where to save signed XML files after successful XAdES-BES signing.
# Structure: <SRI_SIGNED_XML_STORAGE_PATH>/<tenantId>/<documentId>/signed.xml
# If empty, defaults to <SRI_CERT_STORAGE_PATH>/signed-xml
# Must be outside the web-accessible directory.
SRI_SIGNED_XML_STORAGE_PATH=
